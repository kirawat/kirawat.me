# This file tells Docker which files/folders to ignore when copying files
# into the image context during the build (`COPY . .`). This speeds up
# builds and reduces image size by excluding unnecessary files.

# Docker related files.
Dockerfile
docker-compose.yml
.dockerignore

# Git related files.
.git
.gitignore

# Astro build/cache artifacts.
dist/
.astro/

# Dependencies
# (these should be installed INSIDE the container via package manager).
node_modules

# Logs.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
# (should not be baked into the image).
.env
.env.production

# OS-specific files.
.DS_Store
Thumbs.db

# JetBrains setting folder.
.idea/
