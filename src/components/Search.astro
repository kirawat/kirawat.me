---
import Icon from './Icon.astro';
---

<search-button>
  <button id="open-search-button" aria-label="Click to search" title="Click to search">
    <span class="icon"><Icon icon="search" /></span>
    <span class="label">Search</span>
  </button>
</search-button>

<search-modal>
  <div id="search-modal-overlay">
    <div class="search-modal-content">
      <div id="search"></div>
    </div>
  </div>
</search-modal>

<script is:inline>
  window.addEventListener('DOMContentLoaded', (event) => {
    // Initialize PagefindUI.
    if (typeof PagefindUI !== 'undefined') {
      new PagefindUI({
        element: '#search',
        showSubResults: false,
        showImages: false,
      });
    }
    else {
      console.error("PagefindUI is not defined. Check if `/pagefind/pagefind-ui.js` loaded correctly.");
    }

    // Set to `true` to prevent page scroll when search input is visible.
    const preventPageScroll = false;

    const openSearchButton = document.getElementById('open-search-button');
    const searchModalOverlay = document.getElementById('search-modal-overlay');

    const searchInput = searchModalOverlay.querySelector('.pagefind-ui__search-input');
    const clearButton = searchModalOverlay.querySelector('.pagefind-ui__search-clear');

    function clearSearchInput() {
      if (clearButton) {
        clearButton.click();
      }
      else if (searchInput) {
        searchInput.value = '';
      }
    }

    function openSearchModel() {
      clearSearchInput();
      searchModalOverlay.classList.add('active');

      // Focus search input.
      setTimeout(() => {
        if (searchInput) {
          // Ensure it's empty.
          if (searchInput.value !== '') {
            searchInput.value = '';
          }
          searchInput.focus();
        }
      }, 100)

      // Prevent page scroll.
      if (preventPageScroll) {
        document.body.style.overflow = 'hidden';
        document.documentElement.style.overflow = 'hidden';
      }
    }

    function closeSearchModal() {
      searchModalOverlay.classList.remove('active');

      // Restore page scroll.
      if (preventPageScroll) {
        document.body.style.overflow = '';
        document.documentElement.style.overflow = '';
      }
    }

    // Open search modal when clicking on search button.
    if (openSearchButton) {
      openSearchButton.addEventListener('click', openSearchModel);
    }

    // Close search modal when clicking outside of it.
    if (searchModalOverlay) {
      searchModalOverlay.addEventListener('click', (event) => {
        if (event.target === searchModalOverlay) {
          closeSearchModal();
        }
      });
    }
  });
</script>

<style lang="scss">
  @use '../styles/abstracts/variables' as variables;

  $transition-duration: 0.25s;

  $modal-overlay-blur: 6px;
  $modal-padding: 10px;

  search-button #open-search-button {
    display: flex;
    justify-content: left;
    align-items: center;

    padding: 1px 0 0 0;
    width: 180px;
    height: 32px;

    border: 0;
    border-radius: 999rem;
    background-color: var(--color-base-999);
    box-shadow: inset 0 0 0 1px var(--color-base-500);

    color: var(--color-base-400);

    cursor: pointer;

    opacity: 0.5;

    transition:
      box-shadow $transition-duration ease-in,
      opacity $transition-duration ease-in;

    .icon {
      display: inline-block;
      position: relative;
      z-index: 1;

      width: 2rem;
      height: 2rem;
      padding: 0.4rem 0.6rem;

      font-size: 1rem;
    }

    .text {
      font-size: #{variables.$text-size-sm};
    }

    &:hover {
      box-shadow: inset 0 0 0 1px var(--color-primary);
      opacity: 1;
    }

    &:active {
      transform: scale(0.95);
    }
  }

  search-modal #search-modal-overlay {
    display: flex;
    justify-content: center;
    align-items: flex-start;

    position: fixed;
    top: 0;
    left: 0;
    z-index: 1000;

    width: 100%;
    height: 100%;

    padding-top: 10vh;

    background-color: rgba(20, 20, 20, 0.3);
    backdrop-filter: blur($modal-overlay-blur);
    -webkit-backdrop-filter: blur($modal-overlay-blur);

    opacity: 0;
    visibility: hidden;

    transition-property: opacity, visibility;
    transition-duration: $transition-duration, 0s;
    transition-timing-function: ease, linear;
    transition-delay: 0s, $transition-duration;

    &.active {
      opacity: 1;
      visibility: visible;
      transition-delay: 0s, 0s;
    }
  }
</style>