---
import Icon from './Icon.astro';
---

<button id="openSearchButton" aria-label="Click to search" title="Click to search">
  <span class="icon"><Icon icon="search" /></span>
  <span class="text">Search</span>
</button>

<style lang="scss">
  button {
    display: flex;
    justify-content: left;
    align-items: center;
    padding: 1px 0 0 0;
    border: 0;
    width: 180px;
    height: 32px;
    border-radius: 999rem;
    background-color: var(--gray-999);
    box-shadow: inset 0 0 0 1px var(--gray-500);
    cursor: pointer;
    color: var(--gray-400);
    opacity: 0.5;
    transition: box-shadow var(--theme-transition),
                opacity var(--theme-transition);

    .icon {
      z-index: 1;
      position: relative;
      display: inline-block;
      width: 2rem;
      height: 2rem;
      font-size: 1rem;
      padding: 0.4rem 0.6rem;
    }

    .text {
      font-size: var(--text-sm);
    }

    &:hover {
      box-shadow: inset 0 0 0 1px var(--accent-regular);
      opacity: 1;
    }

    &:active {
      transform: scale(0.95);
    }
  }
</style>