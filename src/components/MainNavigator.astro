---
import { env } from '../consts';

import Icon from '../components/Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  title?: string;
};

const {
  title = env.SITE_TITLE,
} = Astro.props;

// Main Menu Items
const textLinks: { label: string, href: string }[] = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Notes', href: '/notes/' },
  { label: 'About', href: '/about/' },
];

// Test if a link is pointing to the current page.
const isCurrentPage = (href: string) => {
  let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
  if (pathname.at(0) !== '/') pathname = '/' + pathname;
  if (pathname.at(-1) !== '/') pathname += '/';
  return pathname === href || (href !== '/' && pathname.startsWith(href));
};
---

<nav>
  <div class="nav-header">
    <div class="site-title">
      <a href="/" class="no-select">{title}</a>
    </div>
  </div>
  <div class="nav-footer">
    <ul class="menu-items">
      {
        textLinks.map(({ label, href }) => {
          const isCurrent = isCurrentPage(href);
          const ariaAttribute = isCurrent ? 'page' : null;
          return (
            <li><a aria-current={ariaAttribute} class="link" href={href}>{label}</a></li>
          )
        })
      }
    </ul>
    <button class="menu-button"><Icon icon="menu" /></button>
    <ThemeToggle />
  </div>
</nav>

<div class="mobile-menu">
  <div class="menu-header">
    <ThemeToggle />
    <button class="close-button"><Icon icon="close" /></button>
  </div>
  <ul class="menu-items">
    {
      textLinks.map(({ label, href }) => {
        const isCurrent = isCurrentPage(href);
        const ariaAttribute = isCurrent ? 'page' : null;
        return (
          <li><a aria-current={ariaAttribute} class="link" href={href}>{label}</a></li>
        )
      })
    }
  </ul>
</div>

<style lang="scss">
  @use '../styles/abstracts/variables' as variables;

  $mobile-header-height: 50px;
  $transition-duration: 0.2s;

  :root {
    --nav-bar-bg-color: rgba(255, 255, 255, 0.45);
    --nav-bar-border-color: #f0f0f0;
    --site-title-color: #{variables.$text-color};
    --menu-button-color: #{variables.$text-color};
  }

  :root.theme-dark {
    --nav-bar-bg-color: rgba(255, 255, 255, 0.05);
    --nav-bar-border-color: #323232;
    --site-title-color: #{variables.$text-color-dark};
    --menu-button-color: #{variables.$text-color-dark};
  }

  nav {
    display: flex;
    justify-content: center;
    align-items: center;
    vertical-align: middle;

    position: sticky;
    top: 0;
    z-index: 100;

    padding: 0 20px;
    height: $mobile-header-height;

    border-bottom: 1px solid var(--nav-bar-border-color);
    background-color: var(--nav-bar-bg-color);
    backdrop-filter: blur(6px);
    --webkit-backdrop-filter: blur(6px);

    font-family: var(--font-brand);
    font-weight: 500;

    .nav-header {
      .site-title {
        display: inline-block;
        
        a {
          color: var(--site-title-color);
          text-decoration: none;
        }
      }
    }

    .nav-footer {
      position: absolute;
      right: 1em;

      .menu-items {
        display: none;
      }

      .menu-button {
        grid-column: 3;

        :global(svg) {
          width: 24px;
          height: 24px;
          color: var(--menu-button-color);
        }
      }

      :global(theme-toggle) {
        display: none;
      }
    }
  }

  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2000;

    background-color: var(--body-bg-color);

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    transform: translateX(100%);
    visibility: hidden;

    transition: transform $transition-duration ease-in-out,
                visibility $transition-duration;

    .menu-header {
      display: flex;
      justify-content: space-between;

      position: absolute;
      top: 0;
      left: 0;
      width: 100%;

      padding: 20px;

      .close-button {
        :global(svg) {
          width: 32px;
          height: 32px;
        }
      }
    }

    .menu-items {
      display: flex;
      flex-direction: column;
      gap: 2rem;

      justify-content: center;
      align-items: center;

      line-height: 1.2;
      list-style: none;
      padding: 0;
      text-align: center;

      .link {
        font-size: #{variables.$text-size-xl};
        text-decoration: none;
      }
    }

    .menu-footer {
      position: absolute;
      bottom: 0;
      left: 0;
      padding: 2rem 1rem;

      width: 100%;

      justify-content: center;
      align-items: center;
      text-align: center;
    }
  }

  .menu-button, .close-button {
    background: none;
    border: none;
    cursor: pointer;
  }

  .menu-items {
    list-style: none;

    .link {
      display: inline-block;
      text-decoration: none;
    }
  }

  :global(body.menu-open) .mobile-menu {
    transform: translateX(0);
    visibility: visible;
  }

  // Prevent the page from scrolling when the menu is open.
  :global(body.menu-open) {
    overflow: hidden;
  }

  @media (min-width: 64em) {
    nav {
      display: grid;
      grid-template-columns: auto 1fr;
      position: relative;

      height: 100%;
      padding: 3rem 5.5rem;

      border: 0;
      background-color: transparent;
      backdrop-filter: none;
      --webkit-backdrop-filter: none;

      .nav-header {
        grid-column: 1 / 2;
        align-items: center;
        gap: 1rem;

        .site-title {
          justify-content: start;
          align-items: start;

          a {
            color: var(--text-color);
          }
        }
      }

      .nav-footer {
        grid-column: 2 / 3;
        display: flex;
        justify-self: flex-end;
        gap: 1em;

        .menu-items {
          display: flex;
          flex-direction: row;
          font-size: #{variables.$text-size-base};

          .link {
            padding: 0.5rem 1rem;
            border-radius: 999rem;
          }
        }

        :global(theme-toggle) {
          display: inline-block;
          padding-top: 1.3em;
        }

        .menu-button {
          display: none;
        }
      }
    }
  }
</style>

<script>
  const menuButton = document.querySelector('.menu-button');
  const closeButton = document.querySelector('.close-button');
  const body = document.body;

  function openMenu() {
    body.classList.add('menu-open');
  }

  function closeMenu() {
    body.classList.remove('menu-open');
  }

  if (menuButton) {
    menuButton.addEventListener('click', openMenu);
  }

  if (closeButton) {
    closeButton.addEventListener('click', closeMenu);
  }

  window.addEventListener('DOMContentLoaded', (event) => {
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && body.classList.contains('menu-open')) {
        closeMenu();
      }
    })
  });
</script>