<article itemprop="text">
  <div class="content">
    <slot />
  </div>
</article>

<style lang="scss">
  @use '../styles/abstracts/variables' as var;

  article .content {
    padding-left: var.$screen-sm-content-padding-h;
    padding-right: var.$screen-sm-content-padding-h;

    // Text

    :global(b, strong) {
      color: var(--text-bold-color);
    }

    // Bulletin

    :global(ul),
    :global(ol) {
      padding-left: var.$screen-sm-content-padding-h;
    }

    // Inline Code
    // ======================================================================
    :global(* > code:not(pre > code)) {
      padding: 2px 4px;

      color: var(--inline-code-text-color);
      font-family: var.$font-mono;
      font-size: var.$text-size-sm;
      background-color: var(--inline-code-bg-color);
      border: 1px solid var(--color-base-800);
      border-radius: var.$radius-s;
      word-break: break-word;
    }

    // Link Inline Code
    :global(p a:has(code)) {
      text-decoration-color: var(--inline-code-text-color);

      &:hover {
        text-decoration-color: var(--color-link-hover);

        :global(code) {
          color: var(--color-link-hover);
        }
      }
    }

    // Code Block
    // ======================================================================
    :global(pre) {
      position: relative;

      font-family: var.$font-mono;
      font-size: var.$text-size-sm;
      border: 1px solid var(--color-base-800);
      border-radius: var.$radius-s;

      overflow-x: auto;

      &::-webkit-scrollbar-thumb {
        background-color: transparent;
      }

      &:hover {
        &::-webkit-scrollbar-thumb {
          background-color: var(--scrollbar-thumb-color);
        }
      }

      :global(code) {
        display: block;

        width: max-content;
        min-width: 100%;
        padding: 1em 1em 1em 0em;
        
        line-height: 1.65rem;
        border-top: 1px solid var(--color-base-800);
        white-space: pre;
        counter-reset: step;

        // Add line number to code block.
        :global(.line) {
          position: relative;
          counter-increment: step;

          &::before {
            position: sticky;
            left: 0;
            z-index: 1;

            display: inline-block;
            margin-right: 0.5rem;
            padding-right: 0.5rem;
            width: 2.3rem;
            height: 1.5rem;

            color: rgba(155, 138, 148, 0.4);
            background-color: var(--code-bg-color);
            font-size: var.$text-size-2xs;
            text-align: right;

            content: counter(step);
          }
        }
      }
    }
  }
</style>