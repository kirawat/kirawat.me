---
const hello = 'Hi, my name is Kirawat Sahasewiyon.';

const wordsList: { label: string; }[] = [
  { label: 'coder' },
  { label: 'thinker' },
  { label: 'gamer' },
  { label: 'foodie' },
  { label: 'dreamer' },
  { label: 'filmmaker' },
];

// Prepare the list for display.
// Duplicating the first item at the end for seamless animation.
const wordsToDisplay = wordsList.length > 0 ? [...wordsList, wordsList[0]] : [];
---

<section class="introduction no-select">
  <div class="typewriter-container">
    <span id="typed-output" data-text={hello}></span>
  </div>
  <div class="flipping-text">
    <span class="static-prefix">I'm a </span>
    <div class="dynamic-words-viewport">
      <ul class="words-list">
        {
          wordsToDisplay.map(({ label }) => (
            <li>{label}.</li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', (): void => {
    const typedOutputElement: HTMLElement | null = document.getElementById('typed-output');

    // Stop script execution if the `typed-output` element isn't found.
    if (!typedOutputElement) {
      return;
    }

    // Retrieve the text to type from the `data-text` attribute.
    const textToType: string | undefined = typedOutputElement.dataset.text;

    // If no text is found in the data-attribute, stop script execution.
    if (!textToType) {
      return;
    }

    // Ensure the element is empty before starting the typing effect.
    typedOutputElement.textContent = '';

    // Speed in milliseconds for typing each character.
    const typingSpeedPerChar: number = 50;

    // Delay in milliseconds before typing starts.
    const initialDisplayDelay: number = 300;

    async function startTypingEffect(): Promise<void> {
      const characters = textToType!.split('');

      for (const char of characters) {
        typedOutputElement!.textContent += char;
        await new Promise(resolve => setTimeout(resolve, typingSpeedPerChar));
      }
    }

    setTimeout(startTypingEffect, initialDisplayDelay);
  });
</script>

<style lang="scss">
  @use '../styles/abstracts/variables' as var;

  // This should be kept in sync if wordsList changes.
  $word-count: 6;

  // Time for each word (hold + slide).
  $time-per-word: 2s;

  // Defines the visibile height for one word. Adjust based on font.
  $word-actual-line-height: 1.75em;

  // Total time for one full loop (e.g., 2s per word).
  $animation-duration-total: $word-count * $time-per-word;

  section.introduction {
    padding: 2.5em 20px;

    .typewriter-container {
      #typed-output {
        position: relative;
        display: inline-block;

        color: var(--color-text-normal);
        font-family: var(--font-brand);
        font-size: 1.1em;
        font-weight: 400;

        &::after {
          // Aligns the cursor with the text.
          vertical-align: -0.1em;

          display: inline-block;

          // Thickness of cursor.
          width: 3px;
          height: 1em;

          // Distane of the cursor from the text.
          margin-left: 4px;

          // Cursor color.
          background-color: var(--color-primary);

          // Blinking animation.
          animation: blink-cursor 0.8s steps(2, start) infinite;
          content: '';
        }
      }
    }

    .flipping-text {
      display: flex;
      align-items: baseline;
      font-size: 1.8rem;

      .static-prefix {
        margin-right: 0.3em;
        white-space: nowrap;
      }

      .dynamic-words-viewport {
        position: relative;
        display: inline-block;
        height: $word-actual-line-height;
        overflow: hidden;

        .words-list {
          margin: 0;
          padding: 0;
          color: var(--color-primary);
          list-style: none;
          
          // Hint to the browser that transform will be animated.
          will-change: transform;

          animation: flip-vertical $animation-duration-total ease-in-out infinite;

          li {
            height: $word-actual-line-height;
            line-height: $word-actual-line-height;
          }
        }
      }
    }
  }

  @media (min-width: var.$screen-md) {
    section.introduction {
      padding: 2.5em 40px;

      .typewriter-container {
        #typed-output {
          font-size: 1.6em;
        }
      }

      .flipping-text {
        font-size: 1.4em;
      }
    }
  }

  @media (min-width: var.$screen-lg) {
    section.introduction {
      padding: 6em var.$content-padding-h;

      .typewriter-container {
        #typed-output {
          font-size: 3em;
        }
      }

      .flipping-text {
        font-size: 2.4em;
      }
    }
  }

  // Keyframes for the cursor's blinking animation.
  @keyframes blink-cursor {
    // First step of the animation (cursor visible).
    from {
      opacity: 1;
    }
    // Second step of the animation (cursor invisible).
    to {
      opacity: 0;
    }
  }

  @keyframes flip-vertical {
    // Loop to generate keyframe steps for each word.
    @for $i from 0 to $word-count {
      // Calculate the percentage of the total animation duration that
      // each word's "slot" occupies.
      $percentagePerSlot: calc(100% / $word-count);

      // Calculate the start of the "hold" period for the current word.
      $startHoldPercentage: calc($i * $percentagePerSlot);

      // Calculate the end of the "hold" period.
      // 80% of the slot's duration is for holding the word.
      $endHoldPercentage: calc($startHoldPercentage + ($percentagePerSlot * 0.8));

      #{$startHoldPercentage}, #{$endHoldPercentage} {
        transform: translateY(calc(#{$i} * #{$word-actual-line-height} * -1));
      }
    }

    // The final step ensures the animation loops correctly to the start.
    100% {
      transform: translateY(calc(#{$word-count} * #{$word-actual-line-height} * -1));
    }
  }
</style>
