---
import { env } from '../consts';

import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title?: string;
}

const {
  title = env.SITE_TITLE,
} = Astro.props;

/** Main Menu Items */
const textLinks: { label: string; href: string }[] = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Digital Garden', href: '/note/' },
  { label: 'About', href: '/about/' },
];

/** Test if a link is pointing to the current page. */
const isCurrentPage = (href: string) => {
  let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
  if (pathname.at(0) !== '/') pathname = '/' + pathname;
  if (pathname.at(-1) !== '/') pathname += '/';
  return pathname === href || (href !== '/' && pathname.startsWith(href));
}
---

<nav>
  <div class="menu-header">
    <a href="/" class="site-title">{title}</a>
  </div>
  <div class="menu-footer">
      <ul class="nav-items">
        {
          textLinks.map(({ label, href }) => (
            <li>
              <a aria-current={isCurrentPage(href) ? 'page' : null} class="link" href={href}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    <div class="theme-toggle"><ThemeToggle /></div>
  </div>
</nav>

<style lang="scss">
  nav {
    display: flex;
    justify-content: space-between;
    z-index: var(--z-index-navbar);
    position: relative;
    margin-bottom: 1rem;
    font-family: var(--font-brand);
    font-weight: 500;

    .menu-header {
      gap: 0.5rem;

      .site-title {
        display: flex;
        gap: 0.5rem;
        align-items: left;
        line-height: 1.1;
        color: var(--gray-0);
        text-decoration: none;
      }
    }

    .menu-footer {
      --icon-size: var(--text-xl);
      --icon-padding: 0.5rem;

      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 1.5rem 2rem 1.5rem 1.5rem;
      box-shadow: var(--shadow-lg);

      .nav-items {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        font-size: var(--text-md);
        line-height: 1.2;
        list-style: none;
        margin: 0;
        padding: 0 2rem 0.36rem 0;

        .link {
          display: inline-block;
          color: var(--gray-300);
          text-decoration: none;
        }

        .link[aria-current] {
          color: var(--gray-0);
        }
      }

      .theme-toggle {
        display: flex;
        height: calc(var(--icon-size) + 2 * var(--icon-padding));
      }
    }

    @media (min-width: 50em) {
      & {
        display: grid;
        grid-template-columns: auto 1fr;
        align-items: center;
        padding: 3rem 5.5rem;
        gap: 1rem;
      }

      .menu-header {
        grid-column: 1 / 2;

        .site-title {
          font-size: var(--text-lg);
        }
      }

      .menu-footer {
        --icon-padding: 0.375rem;

        grid-column: 2 / 3;
        justify-self: flex-end;
        padding: 0;
        background-color: transparent;
        box-shadow: none;

        .nav-items {
          position: relative;
          flex-direction: row;
          font-size: var(--text-base);

          .link {
            padding: 0.5rem 1rem;
            border-radius: 999rem;
            transition:
              color var(--theme-transition),
              background-color var(--theme-transition);
          }

          .link:hover,
          .link:focus {
            color: var(--gray-100);
            background-color: var(--accent-subtle-overlay);
          }

          .link[aria-current='page'] {
            color: var(--accent-text-over);
            background-color: var(--accent-regular);
          }
        }
      }
    }
  }
</style>