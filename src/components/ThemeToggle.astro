---
import Icon from './Icon.astro';
---

<theme-toggle>
  <button>
    <span class="icon light"><Icon icon="sun" /></span>
    <span class="icon dark"><Icon icon="moon-stars" /></span>
  </button>
</theme-toggle>

<style lang="scss">
  $theme-transition-duration: 0.2s;

  button {
    display: flex;
    padding: 0;

    background-color: rgba(255, 255, 255, 0.05);
    box-shadow: inset 0 0 0 1px var(--primary-color);
    border: 0;
    border-radius: 999rem;

    cursor: pointer;

    .icon {
      display: flex;
      position: relative;
      z-index: 1;

      padding: 0.5rem;

      &.light {
        :global(html:not(.theme-dark)) & {
          color: #ffffff;
        }

        &::before {
          content: '';

          position: absolute;
          z-index: -1;
          inset: 0;

          background-color: var(--primary-color);
          border-radius: 999rem;

          :global(.theme-dark) & {
            transform: translateX(100%);
          }

          @media (forced-colors: active) {
            background-color: SelectedItem;
          }
        }
      }

      &.dark {
        :global(.theme-dark) & {
          color: #ffffff;
        }
      }

      @media (prefers-reduced-motion: no-preference) {
        &,
        &.light::before {
          transition:
            transform $theme-transition-duration ease-in-out,
            color $theme-transition-duration ease-in-out;
        }
      }

      &[aria-pressed='false'] .icon.light {
        color: red;
      }
    }
  }
</style>

<script>
  class ThemeToggle extends HTMLElement {
    constructor() {
      super();

      const button = this.querySelector('button')!;

      // Set the theme to dark/light mode.
      const setTheme = (dark: boolean) => {
        document.documentElement.classList[dark ? 'add' : 'remove']('theme-dark');
        button.setAttribute('aria-pressed', String(!dark));
      };

      // Toggle the theme when a user clicks the button.
      button.addEventListener('click', () => setTheme(!this.isDark()));

      // Initialize button state to reflex current theme.
      setTheme(this.isDark());
    }

    isDark() {
      return document.documentElement.classList.contains('theme-dark');
    }
  }
  customElements.define('theme-toggle', ThemeToggle);
</script>