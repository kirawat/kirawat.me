---
import Icon from './Icon.astro';
---

<theme-toggle>
  <button>
    <span class="icon light"><Icon icon="sun" /></span>
    <span class="icon dark"><Icon icon="moon-stars" /></span>
  </button>
</theme-toggle>

<script>
  class ThemeToggle extends HTMLElement {
    // Define a private class property to hold the button element.
    private button!: HTMLButtonElement;

    constructor() {
      super();

      const buttonElement = this.querySelector('button');

      if (!buttonElement) {
        return;
      }
      this.button = buttonElement;

      // Add the click listener.
      this.button.addEventListener('click', () => this.setTheme(!this.isDark()));

      // Initialize the theme state when the component is created.
      this.setTheme(this.isDark());
    }

    /**
     * Checks if the current theme is dark.
     * @returns {boolean} True if the body has the 'theme-dark' class.
     */
    private isDark(): boolean {
      return document.documentElement.classList.contains('theme-dark');
    }

    /**
     * Sets the theme based on the provided boolean.
     * @param {boolean} dark - True to switch to dark mode, false for light.
     */
    private setTheme(dark: boolean): void {
      document.documentElement.classList.toggle('theme-dark', dark);
      this.button.setAttribute('aria-pressed', String(dark));
    }
  }
  
  customElements.define('theme-toggle', ThemeToggle);
</script>

<style lang="scss">
  $theme-transition-duration: 0.2s;

  button {
    display: flex;
    padding: 0;

    background-color: rgba(255, 255, 255, 0.05);
    border: 0;
    border-radius: 999rem;
    box-shadow: inset 0 0 0 1px var(--color-primary-overlay);
    
    cursor: pointer;

    .icon {
      position: relative;
      z-index: 1;

      display: flex;
      padding: 0.5rem;

      &.light {
        :global(html:not(.theme-dark)) & {
          color: #ffffff;
        }

        &::before {
          position: absolute;
          inset: 0;
          z-index: -1;

          background-color: var(--color-primary);
          border-radius: 999rem;

          content: '';

          :global(.theme-dark) & {
            transform: translateX(100%);
          }

          @media (forced-colors: active) {
            background-color: SelectedItem;
          }
        }
      }

      &.dark {
        :global(.theme-dark) & {
          color: #ffffff;
        }
      }

      @media (prefers-reduced-motion: no-preference) {
        &,
        &.light::before {
          transition:
            transform $theme-transition-duration ease-in-out,
            color $theme-transition-duration ease-in-out;
        }
      }

      &[aria-pressed='false'] .icon.light {
        color: red;
      }
    }
  }
</style>