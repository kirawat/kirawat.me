---
import { type CollectionEntry, getCollection, render } from 'astro:content';

import { formatDate } from '../../utils/date-utils';

import BaseLayout from '../../layouts/BaseLayout.astro';

import Article from '../../components/Article.astro';
import Icon from '../../components/Icon.astro';

interface Props {
  entry: CollectionEntry<'notes'>;
}

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  });
  return notes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const datePublished = formatDate(entry.data.datePublished);
const dateModified = formatDate(entry.data.dateModified);
---

<BaseLayout>
  <main data-pagefind-body itemscope itemtype="https://schema.org/Blog">
    <header>
      <div class="header-container">
        <div class="post-meta">
          <a class="back-link" href="/notes/"><Icon icon="arrow-left" /> Notes</a>
          <h1 class="post-title" itemprop="name">{entry.data.name}</h1>
          <span class="post-date">
            {
              datePublished && (
                <p>Published: {datePublished}</p>
              )
            }
            {
              dateModified && (
                <p>Last updated: {dateModified}</p>
              )
            }
          </span>
        </div>
      </div>
    </header>
    <Article>
      <Content />
    </Article>
  </main>
</BaseLayout>

<style lang="scss">
  @use '../../styles/abstracts/variables' as var;

  .header-container {
    margin-top: 1em;
    margin-bottom: 2.5em;
    padding: 0 var.$screen-sm-content-padding-h;

    .post-meta {
      .back-link {
        font-size: var.$text-size-sm;
        background-image: linear-gradient(to right, currentColor, currentColor);
        background-position: 1.25em 100%;
        background-size: 0% 1px;
        background-repeat: no-repeat;
        text-decoration: none;
        transition: background-size var.$theme-transition;

        &:hover,
        &:focus {
          background-size: 100% 1px;
        }
      }

      .post-title {
        margin-top: 0.4em;
        padding: 0;
        font-size: var.$text-size-xl;
        line-height: 1.3em;
      }

      .post-date {
        font-size: var.$text-size-sm;
        line-height: 1em;
      }
    }
  }

  @media (min-width: var.$screen-md) {
    .header-container {
      padding: 0 var.$screen-md-content-padding-h;

      .post-meta {
        .back-link {
          font-size: var.$text-size-base;
        }
      }
    }
  }

  @media (min-width: var.$screen-lg) {
    .header-container {
      display: grid;
      grid-template-columns: 1fr var.$article-width 1fr;

      .post-meta {
        grid-column: 2;

        .post-title {
          font-size: var.$text-size-2xl;
        }
      }
    }
  }
</style>
