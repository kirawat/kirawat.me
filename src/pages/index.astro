---
import BaseLayout from '../layouts/BaseLayout.astro';

const myName = 'Kirawat Sahasewiyon';

const wordsList: { label: string; }[] = [
	{ label: 'dreamer' },
	{ label: 'thinker' },
	{ label: 'gamer' },
	{ label: 'coder' },
	{ label: 'filmmaker' },
];

// Prepare the list for display, duplicating the first item at the end
// for seamless animation.
const wordsToDisplay = wordsList.length > 0 ? [...wordsList, wordsList[0]] : [];
---

<BaseLayout>
	<div class="typewriter-container">
		<span id="typed-output" data-text={`Hi, my name is ${myName}.`}></span>
	</div>
	<div class="fliping-text-container">
		<span class="static-prefix">I'm a </span>
		<div class="dynamic-words-viewport">
			<ul class="words-list">
				{
					wordsToDisplay.map(({ label }) => (
						<li>{label}.</li>
					))
				}
			</ul>
		</div>
	</div>
</BaseLayout>

<style lang="scss">
	$number-of-words: 5;

	// Time for each word (hold + slide).
	$time-per-word: 2s;

	// Defines the visible height for one word. Adjust based on font.
	$word-actual-line-height: 1.7em;

	// Total time for one full loop (e.g., 2s per word).
	$animation-duration-total: $number-of-words * $time-per-word;

	.typewriter-container {
		#typed-output {
			display: inline-block;
			position: relative;
			font-family: var(--font-brand);
			font-size: 3em;
			font-weight: 600;

			&::after {
				content: '';
				display: inline-block;

				// Thickness of cursor.
				width: 3px;
				height: 0.85em;

				// Cursor color.
				background-color: var(--accent-regular);

				// Distance of the cursor from the text.
				margin-left: 2px;

				// Aligns the cursor with the text.
				vertical-align: -0.1em;

				// Blinking animation.
				animation: blink-cursor 0.8s steps(2, start) infinite;
			}
		}
	}

	/// Keyframes for the cursor's blinking animation.
	@keyframes blink-cursor {
		// First step of the animation (cursor visible).
		from {
			opacity: 1;
		}
		// Second step of the animation (cursor invisible).
		to {
			opacity: 0;
		}
	}

	.fliping-text-container {
		display: flex;
		font-size: 2.5em;
		
		.static-prefix {
			margin-right: 0.3em;
			white-space: nowrap;
		}

		.dynamic-words-viewport {
			height: $word-actual-line-height;
			overflow: hidden;
			display: inline-block;
			position: relative;
			vertical-align: baseline;
			text-align: left;

			.words-list {
				list-style: none;
				padding: 0;
				margin: 0;
				color: var(--accent-regular);

				// Hint to the browser that transform will be animated.
				will-change: transform;

				// Forces hardware acceleration.
				transform: translateZ(0);

				// Prevent flickering and improve rendering quality on transformed elements.
				backface-visibility: hidden;

				animation: flip-vertical $animation-duration-total ease-in-out infinite;

				& li {
					height: $word-actual-line-height;
					line-height: $word-actual-line-height;
					display: block;
				}
			}
		}
	}

	@keyframes flip-vertical {
		// Loop to generate keyframe steps for each word.
		@for $i from 0 to $number-of-words {
			// Calculate the percentage of the total animation duration that
			// each word's "slot" occupies.
			$percentagePerSlot: 100% / $number-of-words;

			// Calculate the start of the "hold" period for the current word.
			$startHoldPercentage: $i * $percentagePerSlot;

			// Calculate the end of the "hold" period.
			// 80% of the slot's duration is for holding the word.
			$endHoldPercentage: $startHoldPercentage + ($percentagePerSlot * 0.8);

			#{$startHoldPercentage}, #{$endHoldPercentage} {
				transform: translateY(calc(#{$i} * #{$word-actual-line-height} * -1));
			}
		}

		// The final step ensures the animation loops correctly to the start.
		100% { transform: translateY(calc(#{$number-of-words} * #{$word-actual-line-height} * -1)); }
	}
</style>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const typedOutputElement = document.getElementById('typed-output');

		// Stop script execution if the `typed-output` element isn't found.
		if (!typedOutputElement) {
			return;
		}

		// Retrieve the text to type from the `data-text` attribute
		// of the HTML element.
		const textToType = typedOutputElement.dataset.text;

		// If no text is found in the data-attribute, stop script execution.
		if (textToType === undefined || textToType === null) {
			return;
		}

		// Ensure the element is empty before starting the typing effect.
		typedOutputElement.textContent = '';

		// Soeed in milliseconds for typing each character.
		const typingSpeedPerChar = 50;

		/// Delay in milliseconds before typing starts.
		const initialDisplayDelay = 500;

		async function startTypingEffect() {
			const characters = textToType.split('');
			for (let i = 0; i < characters.length; i++) {
				typedOutputElement.textContent += characters[i];
				await new Promise(resolve => setTimeout(resolve, typingSpeedPerChar));
			}
		}

		setTimeout(startTypingEffect, initialDisplayDelay);
	});
</script>