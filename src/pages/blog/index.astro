---
import { getCollection } from 'astro:content';
import { sortByDate } from '../../utils/date-utils';

import BaseLayout from '../../layouts/BaseLayout.astro';

const blogPosts = (await getCollection('blog', ({ data }) => {
  // In production (PROD), only include posts where draft is not true.
  // In development (DEV), include all posts.
  return import.meta.env.PROD ? data.draft !== true : true;
})).sort(
  sortByDate({ useModifiedDate: false }),
);

const posts = blogPosts;
---

<BaseLayout>
  <section class="content-container">
    <div class="blog-posts">
      <ul>
        {
          posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}`}>{post.data.name}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  $article-min-width: 320px;
  $article-max-width: 780px;
  $article-width: minmax($article-min-width, $article-max-width);

  section.content-container {
    display: grid;
    grid-template-columns: 1fr $article-width 1fr;

    .blog-posts {
      grid-column: 2;
    }
  }
</style>