---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';

const blogPosts = (await getCollection('blog', ({ data }) => {
  // In production (PROD), only include posts where draft is not true.
  // In development (DEV), include all posts.
  return import.meta.env.PROD ? data.draft !== true : true;
})).sort(
  (a, b) => {
    // The sort priority is:
    // 1. dateModified (if it exists).
    // 2. datePublished (if it exists).
    // 3. dateCreated (as the final fallback).

    const effectiveDateA = a.data.dateModified || a.data.datePublished || a.data.dateCreated;
    const effectiveDateB = b.data.dateModified || b.data.datePublished || a.data.dateCreated;

    // Convert the effective dates to numerical timestaps for comparison.
    const timeA = effectiveDateA.valueOf();
    const timeB = effectiveDateB.valueOf();

    // Sort in descending order (newest items will appear first).
    // If `timeB` is more recent (larger timestamp) than `timeA`, this
    // returns a positive number, which means 'b' will be sorted before 'a'.
    return timeB - timeA;
  } ,
);
---

<BaseLayout>
  <ul>
    {
      blogPosts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`}>{post.data.name}</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>