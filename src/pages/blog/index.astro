---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { render } from 'astro:content';

const blogPosts = (await getCollection('blog', ({ data }) => {
  // In production (PROD), only include posts where draft is not true.
  // In development (DEV), include all posts.
  return import.meta.env.PROD ? data.draft !== true : true;
})).sort(
  (a, b) => {
    // The sort priority is:
    // 1. dateModified (if it exists).
    // 2. datePublished (if it exists).
    // 3. dateCreated (as the final fallback).

    const effectiveDateA = a.data.dateModified || a.data.datePublished || a.data.dateCreated;
    const effectiveDateB = b.data.dateModified || b.data.datePublished || a.data.dateCreated;

    // Convert the effective dates to numerical timestaps for comparison.
    const timeA = effectiveDateA.valueOf();
    const timeB = effectiveDateB.valueOf();

    // Sort in descending order (newest items will appear first).
    // If `timeB` is more recent (larger timestamp) than `timeA`, this
    // returns a positive number, which means 'b' will be sorted before 'a'.
    return timeB - timeA;
  } ,
);

const posts = blogPosts.slice(0, 5);
---

<BaseLayout>
  <section class="content-container">
    {
      posts.map(async (post) => {
        const { Content } = await render(post);
        return (
          <div class="blog-post">
            <header>
              <h1 class="post-title">{post.data.name}</h1>
            </header>
            <article class="post-content">
              <Content />
            </article>
          </div>
        );
      })
    }
  </section>
</BaseLayout>

<style lang="scss">
  $article-min-width: 320px;
  $article-max-width: 780px;
  $article-width: minmax($article-min-width, $article-max-width);

  section.content-container {
    display: grid;
    grid-template-columns: 1fr $article-width 1fr;

    .blog-post {
      grid-column: 2;

      // This CSS rule add vertical spacing between direct child elements
      // of an element with the class `content`, but without adding space
      // above the very first child.
      & > :global(* + *),
      & :global(blockquote > * + *),
      & :global(li:has(> p)),
      & :global(li > * + *),
      & :global(ul > li > ul > li:only-child) {
        margin-top: 1rem;
      }

      & :global(ul > li:has(table) > p) {
        margin-bottom: 1rem;
      }
    }
  }
</style>