---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BaseLayout>
  <h1>{title}</h1>
  <main class="content">
    <article>
      <slot />
    </article>
  </main>
</BaseLayout>

<style lang="scss">
  $article-min-width: 320px;
  $article-max-width: 780px;
  $article-width: minmax($article-min-width, $article-max-width);

  main.content {
    display: grid;
    grid-template-columns: 1fr $article-width 1fr;

    article {
      grid-column: 2;
    }
  }
</style>