---
import '../styles/main.scss';

import { generateGoogleFontsUrl } from '../utils/font-utils';

import MainNavigator from '../components/MainNavigator.astro';

interface FontConfig {
  name: string;
  weight?: (number | string)[];
  italics?: (number | string)[];
}

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  fontList?: FontConfig[];
  copyright?: string | undefined;
}

const defaultFontList = [
  {
    name: 'IBM Plex Sans',
    weights: [400, 600],
    italics: [400, 500],
  },
  {
    name: 'Rubik',
    weights: [400],
    italics: [500],
  },
  {
    name: 'JetBrains Mono',
    weights: [400, 700],
    italics: [400, 700],
  },
]

const copyrightSymbol = String.fromCodePoint(0x00A9);
const currentYear = new Date().getFullYear();

const {
  title = 'Kirawat Sahasewiyon',
  description,
  fontList = defaultFontList,
  copyright = `${copyrightSymbol} ${currentYear} Kirawat Sahasewiyon`,
} = Astro.props;

let googleFontsUrl = '';
if (fontList.length > 0) {
  googleFontsUrl = generateGoogleFontsUrl(fontList);
}
---

<!DOCTYPE html>
<html lang="en" itemscope itemtype="https://schema.org/Website">
<head>
  <meta charset="UTF-8" />
  <meta name="description" property="og:description" content={description} />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />

  <title itemprop="name">{title}</title>

  <link rel="icon" type="image/svg+xml" href="/favorite.svg" />
  {
    googleFontsUrl && (
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link rel="stylesheet" href={googleFontsUrl} />
    )
  }
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline defer src="/pagefind/pagefind-ui.js" />
  <script is:inline src="/src/scripts/theme-init.ts" />

  <slot name="head" />
</head>
<body>
  <MainNavigator />
  <main>
    <slot />
  </main>
  <footer>
    <p>{copyright}</p>
  </footer>
</body>
</html>

<style lang="scss">
  @use '../styles/abstracts/variables' as var;

  body {
    display: flex;
    flex-direction: column;
  }

  footer {
    display: flex;
    flex-direction: column;
    gap: 3rem;

    margin-top: auto;
    padding: 3rem 2rem 3rem;

    color: var(--color-base-400);
    font-size: var.$text-size-sm;
    text-align: center;
  }
</style>